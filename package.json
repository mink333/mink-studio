{
  "name": "mink-studio",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:db-up": "docker compose -f docker-compose.dev.yml --env-file ./apps/api/.env up -d",
    "dev:db-down": "docker compose -f docker-compose.dev.yml --env-file ./apps/api/.env down"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
