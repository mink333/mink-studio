// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  name              String?
  image             String?
  email             String?        @unique
  role              String         @default("USER")
  provider          String
  providerAccountId String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  refreshTokens     RefreshToken[]

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  name  String @unique
  posts Post[]
}

model Post {
  id         Int         @id @default(autoincrement())
  slug       String      @unique
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title      String
  summary    String
  toc        Json
  content    Json
  images     PostImage[]
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // 복합 인덱스 적용: 카테고리별/작성자별 최신글 조회 최적화
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model PostImage {
  id           Int      @id @default(autoincrement())
  postId       Int
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url          String
  width        Int
  height       Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([postId, displayOrder])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String    @db.VarChar(1000)

  postId    Int
  authorId  String?   // '알 수 없는 사용자' 처리를 위해 Optional 변경
  parentId  Int?

  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull) // onDelete: SetNull 추가
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  // 복합 인덱스 적용: 특정 게시글의 댓글 과거순 조회 최적화
  @@index([postId, createdAt(sort: Asc)])
  @@index([parentId])
  @@index([authorId, createdAt])
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Project {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  summary       String
  period        String
  status        String    @default("Completed")
  isFeatured    Boolean   @default(false)
  order         Int       @default(0)

  devStack      String[]
  visualStack   String[]

  demoUrl       String?
  githubUrl     String

  readmeContent String?   @db.Text
  syncedAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([order(sort: Asc)])
  @@index([isFeatured])
}